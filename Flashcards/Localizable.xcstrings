    "Sélectionner" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Select" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Auswählen" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Seleccionar" } } } },
    "Désélectionner" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Deselect" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Auswahl aufheben" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Deseleccionar" } } } },
    "Ajoutez au moins une carte pour créer le deck." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Add at least one card to create the deck." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Füge mindestens eine Karte hinzu, um das Deck zu erstellen." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Añade al menos una tarjeta para crear el deck." } } } },
    "Recherchez un dossier, un deck ou le contenu d’une carte." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Search for a folder, deck, or card content." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Suche nach einem Ordner, Deck oder Karteninhalt." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Busca una carpeta, un deck o el contenido de una tarjeta." } } } },
    "Dossiers, decks et cartes" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Folders, decks and cards" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Ordner, Decks und Karten" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Carpetas, decks y tarjetas" } } } },
    "Doublons détectés" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Duplicates Detected" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Duplikate erkannt" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Duplicados detectados" } } } },
    "Ignorer les doublons exacts" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Skip Exact Duplicates" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Exakte Duplikate überspringen" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Omitir duplicados exactos" } } } },
    "Importer quand même" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Import Anyway" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Trotzdem importieren" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Importar de todos modos" } } } },
    "import.duplicates.both" : { "localizations" : { "fr" : { "stringUnit" : { "state" : "translated", "value" : "%lld doublon(s) exact(s) et %lld doublon(s) possible(s) ont été détectés. Les doublons possibles ont le même terme mais une définition différente." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld exact duplicate(s) and %lld possible duplicate(s) were found. Possible duplicates share the same term but have a different definition." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "%lld exakte und %lld mögliche Duplikate wurden gefunden. Mögliche Duplikate haben denselben Begriff, aber eine andere Definition." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Se encontraron %lld duplicados exactos y %lld duplicados posibles. Los duplicados posibles tienen el mismo término pero una definición diferente." } } } },
    "import.duplicates.possible" : { "localizations" : { "fr" : { "stringUnit" : { "state" : "translated", "value" : "%lld doublon(s) possible(s) ont été détectés. Ils ont le même terme qu’une autre carte mais une définition différente." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld possible duplicate(s) were found. They share the same term but have a different definition." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "%lld mögliche Duplikate wurden gefunden. Sie haben denselben Begriff wie eine andere Karte, aber eine andere Definition." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Se encontraron %lld duplicados posibles. Tienen el mismo término que otra tarjeta pero una definición diferente." } } } },
    "import.duplicates.exact" : { "localizations" : { "fr" : { "stringUnit" : { "state" : "translated", "value" : "%lld doublon(s) exact(s) ont été détectés." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld exact duplicate(s) were found." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "%lld exakte Duplikate wurden gefunden." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Se encontraron %lld duplicados exactos." } } } },
    "Effacer l’historique" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Clear History" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Verlauf löschen" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Borrar historial" } } } },
    "Actions de l’historique" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "History Actions" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Verlaufsaktionen" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Acciones del historial" } } } },
