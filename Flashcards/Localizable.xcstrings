    "Déplacer vers un deck" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Move to deck" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "In Deck verschieben" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Mover a un deck" } } } },
