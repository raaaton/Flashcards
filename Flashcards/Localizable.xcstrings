    "Chaque carte commencée doit avoir un terme et une définition." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Each started card must have a term and a definition." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Jede begonnene Karte muss einen Begriff und eine Definition haben." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Cada tarjeta iniciada debe tener un término y una definición." } } } },
