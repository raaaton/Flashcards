    "Créez d’abord un deck ou choisissez « Nouveau deck »." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Create a deck first or choose New Deck." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Erstelle zuerst ein Deck oder wähle „Neues Deck“." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Crea primero un deck o elige «Nuevo deck»." } } } },
    "Collez du texte pour afficher l’aperçu." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Paste text to display the preview." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Füge Text ein, um die Vorschau anzuzeigen." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Pega texto para mostrar la vista previa." } } } },
    "Saisissez un délimiteur personnalisé non vide." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Enter a non-empty custom delimiter." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Gib ein nicht leeres benutzerdefiniertes Trennzeichen ein." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Introduce un delimitador personalizado que no esté vacío." } } } },
    "Aucune carte détectée." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No cards detected." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Keine Karten erkannt." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "No se detectaron tarjetas." } } } },
    "Les lignes signalées seront ignorées ; les autres seront importées." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Flagged lines will be ignored; the others will be imported." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Markierte Zeilen werden ignoriert; die übrigen werden importiert." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Las líneas marcadas se ignorarán; las demás se importarán." } } } },
